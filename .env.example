# CalDAV Configuration (for calendar events)
CALDAV_URL=https://your-caldav-server.com/calendar
CALDAV_USERNAME=your-username
CALDAV_PASSWORD=your-password
CALDAV_CALENDAR_NAME=your-calendar

# Apple CalDAV Configuration (for Reminders/Tasks)
# iCloud CalDAV URL format: https://caldav.icloud.com/
APPLE_CALDAV_URL=https://caldav.icloud.com/
APPLE_CALDAV_USERNAME=your-apple-id@icloud.com
APPLE_CALDAV_PASSWORD=your-app-specific-password
# Optional: Specific reminders list name (e.g., "Reminders", "Work", "Personal")
APPLE_CALDAV_TASKS_LIST=Reminders

# Home Assistant Configuration
HA_BASE_URL=http://192.168.1.xxx:8123
HA_TOKEN=your-long-lived-access-token

# Weather Configuration (Open-Meteo)
WEATHER_LATITUDE=52.3676
WEATHER_LONGITUDE=4.9041
WEATHER_LOCATION_NAME=Amsterdam

# Kindle Configuration
KINDLE_HOST=192.168.1.xxx
KINDLE_USER=root
# Optional: Set password for password-based SSH (requires sshpass)
# KINDLE_PASSWORD=your-password
KINDLE_DIR=/mnt/us/dashboards
KINDLE_SCRIPT=/mnt/us/rotate-display.sh

# Dashboard server (where the Kindle pulls images from; see server/README.md)
DASHBOARD_SERVER_URL=http://192.168.1.xxx:8090
DASHBOARD_TRIGGER_URL=http://192.168.1.xxx:8091
